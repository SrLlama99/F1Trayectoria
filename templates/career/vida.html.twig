{% extends 'base.html.twig' %}

{% set partidaId = partida.idPartida %}

{% block title %}FIA CENTRAL - ESTILO DE VIDA
{% endblock %}

{% block body %}
	<div class="min-h-screen bg-slate-950 text-white p-6 pl-20 transition-all">
		<div class="max-w-7xl mx-auto space-y-6">

			<header class="flex flex-col md:flex-row justify-between items-start md:items-center bg-slate-900/40 border border-slate-900 p-5 rounded-xl backdrop-blur-sm gap-4">
				<div>
					<span class="text-indigo-400 font-racing text-xs tracking-widest block uppercase">Vida Fuera del Circuito // Social</span>
					<h1 class="text-2xl font-black font-racing uppercase italic mt-0.5">ESTILO DE
						<span class="text-indigo-400">VIDA</span>
					</h1>
				</div>

				<div class="flex items-center gap-3 w-full md:w-auto">
					<a href="/career/casino/{{ partida.idPartida }}" class="flex-1 md:flex-none text-center font-racing text-xs font-black tracking-widest uppercase bg-slate-900 hover:bg-amber-600 border border-slate-800 hover:border-amber-500 text-slate-300 hover:text-slate-950 px-6 py-3 rounded-lg transition-all shadow-md group">
						🎰 CASINO
						<span class="inline-block transition-transform group-hover:scale-120">🃏</span>
					</a>
					<a href="/career/shop/{{ partida.idPartida }}" class="flex-1 md:flex-none text-center font-racing text-xs font-black tracking-widest uppercase bg-gradient-to-r from-cyan-500 to-sky-500 hover:from-cyan-400 hover:to-sky-400 text-slate-950 px-6 py-3 rounded-lg transition-all shadow-[0_4px_15px_rgba(6,182,212,0.2)] hover:shadow-[0_4px_20px_rgba(6,182,212,0.4)]">
						🛍️ VISITAR TIENDA
					</a>
				</div>
			</header>

			{% set progresoVida = piloto.estiloDeVida|default(45) %} {# Fallback a 45% si no viene de base de datos #}
			<div class="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-xl relative overflow-hidden font-mono text-xs">
				<div class="absolute top-0 right-0 w-64 h-64 bg-cyan-500/5 rounded-full blur-3xl pointer-events-none"></div>
				
				<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 mb-3">
					<div>
						<h2 class="text-xs font-racing text-cyan-400 uppercase tracking-wider flex items-center gap-2">
							✨ Estatus & Nivel de Vida
						</h2>
						<p class="text-[10px] text-slate-400 mt-0.5">Progreso global basado en tus propiedades, lujos y reputación fuera del paddock.</p>
					</div>
					<div class="bg-slate-950 border border-slate-850 px-3 py-1 rounded-md text-right">
						<span class="text-slate-500 text-[9px] uppercase font-racing block">Nivel Actual</span>
						<span class="font-bold text-cyan-400 text-sm">
							{% if progresoVida >= 80 %}Celebridad Glamurosa
							{% elseif progresoVida >= 50 %}Piloto de Élite
							{% elseif progresoVida >= 25 %}Promesa Deportiva
							{% else %}Novato del Paddock
							{% endif %}
						</span>
					</div>
				</div>

				<div class="space-y-1.5">
					<div class="w-full bg-slate-950 h-3 rounded-full overflow-hidden border border-slate-850 p-0.5 flex items-center">
						<div class="h-full rounded-full transition-all duration-700 bg-gradient-to-r from-cyan-500 via-indigo-500 to-purple-500 shadow-[0_0_10px_rgba(6,182,212,0.3)]" 
							 style="width: {{ progresoVida }}%"></div>
					</div>
					<div class="flex justify-between items-center text-[10px] text-slate-500 uppercase tracking-tight">
						<span class="text-white font-bold bg-slate-950 px-1.5 py-0.5 border border-slate-850 rounded">{{ progresoVida }}%</span>
						<span>Máximo Estatus</span>
					</div>
				</div>
			</div>

			<div class="bg-slate-900 border border-slate-800 rounded-xl p-6 shadow-2xl relative overflow-hidden">
				<div class="absolute top-0 right-0 w-96 h-96 bg-indigo-500/5 rounded-full blur-3xl pointer-events-none"></div>

				<div class="border-b border-slate-800 pb-3 mb-6">
					<h2 class="text-sm font-racing text-slate-400 uppercase tracking-wider flex items-center gap-2">
						👥 Red de Contactos y Afinidad
					</h2>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
					{% for relacion in relaciones %}
						{# Detectar si el actor está inactivo o no asignado #}
						{% set esInactivo = (relacion.nombreActor|upper == 'INACTIVO') %}
						<div class="bg-slate-950/60 border rounded-xl p-4 flex flex-col justify-between space-y-4 transition-all duration-300 font-mono text-xs
								   {{ esInactivo ? 'opacity-40 border-slate-900 select-none grayscale' : 'border-slate-800 hover:border-indigo-500/40 hover:bg-slate-950 shadow-md' }}">

							<div class="flex justify-between items-start">
								<div>
									<span class="text-[10px] font-racing uppercase tracking-wider px-2 py-0.5 rounded bg-slate-900 border border-slate-800 text-slate-400">
										{{ relacion.tipoActor|replace({'_': ' '}) }}
									</span>
									<h3 class="text-sm font-bold text-white mt-2">
										{{ esInactivo ? 'Sin Relación Asignada' : relacion.nombreActor }}
									</h3>
								</div>

								<span class="text-xl p-1.5 bg-slate-900/80 rounded-lg border border-slate-800/50">
									{% if relacion.tipoActor == 'NOVIA' %}❤️
										{% elseif relacion.tipoActor == 'ESCUDERIA' %}🏎️
										{% elseif relacion.tipoActor == 'TEAM_PRINCIPAL' %}👔
										{% elseif relacion.tipoActor == 'COMPANERO' %}👥
										{% elseif 'PATROCINADOR' in relacion.tipoActor %}🤝
										{% else %}👤
									{% endif %}
								</span>
							</div>

							<div class="space-y-1.5">
								<div class="flex justify-between items-center text-[11px]">
									<span class="text-slate-500 uppercase font-racing text-[9px]">Afinidad</span>
									<span class="font-bold {{ esInactivo ? 'text-slate-600' : (relacion.afinidad >= 75 ? 'text-emerald-400' : (relacion.afinidad <= 30 ? 'text-rose-400' : 'text-indigo-400')) }}">
										{{ esInactivo ? '0' : relacion.afinidad }}%
									</span>
								</div>

								<div class="w-full bg-slate-900 h-1.5 rounded-full overflow-hidden border border-slate-950">
									<div class="h-full transition-all duration-500
												{{ esInactivo ? 'bg-slate-800' : (relacion.afinidad >= 75 ? 'bg-gradient-to-r from-emerald-500 to-teal-400' : (relacion.afinidad <= 30 ? 'bg-gradient-to-r from-rose-600 to-orange-500' : 'bg-gradient-to-r from-indigo-500 to-purple-500')) }}" style="width: {{ esInactivo ? 0 : relacion.afinidad }}%"></div>
								</div>

								<div class="text-[9px] text-slate-500 text-right uppercase tracking-tight pt-0.5">
									{% if esInactivo %}
										Desconectado
									{% elseif relacion.afinidad >= 80 %}
										Lealtad Excelente
									{% elseif relacion.afinidad >= 50 %}
										Afinidad Neutral
									{% else %}
										Tensión / Enemistad
									{% endif %}
								</div>
							</div>

						</div>
					{% else %}
						<div class="col-span-full bg-slate-950/40 border border-slate-900 border-dashed text-center p-8 rounded-xl text-slate-500">
							📭 No hay registros de relaciones para este piloto en la base de datos central.
						</div>
					{% endfor %}
				</div>
			</div>

		</div>
	</div>
{% endblock %}