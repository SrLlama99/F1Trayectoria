{% extends 'base.html.twig' %}
{% set partidaId = partida.idPartida %}
{% block title %}FIA CENTRAL - BÚSQUEDA
{% endblock %}

{% block body %}
	<div class="min-h-screen bg-slate-950 text-white p-6 pl-20 transition-all">
		<div
			class="max-w-7xl mx-auto space-y-6">

			<!-- HEADER DEL MÓDULO -->
			<header class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center bg-slate-900/40 border border-slate-900 p-4 rounded-xl backdrop-blur-sm">
				<div>
					<span class="text-red-500 font-racing text-xs tracking-widest block uppercase">Servicios de Información // FIA</span>
					<h1 class="text-2xl font-black font-racing uppercase italic mt-0.5">BÚSQUEDA DE
						<span class="text-cyan-400">PERSONAL</span>
					</h1>
				</div>

				<!-- Buscador -->
				<div class="md:col-span-2 bg-slate-950/60 border border-slate-900 rounded-lg p-2 flex items-center font-mono text-xs">
					<form id="search-form" method="GET" action="{{ path('app_career_search', { 'partidaId': partidaId }) }}" class="w-full flex gap-2">
						<div class="relative flex-grow w-full">
							<span class="absolute inset-y-0 left-3 flex items-center text-slate-500">🔍</span>
							<input id="search-input" type="text" name="q" class="w-full bg-slate-900/90 border border-slate-800 text-slate-200 placeholder-slate-600 rounded-md py-2 pl-9 pr-4 text-xs font-mono focus:outline-none focus:border-cyan-500 transition-colors" placeholder="Escribe para buscar pilotos o escuderías en tiempo real..." value="{{ texto }}" autocomplete="off">
						</div>
					</form>
				</div>
			</header>

			{# Paneles de Resultados Dinámicos #}
			<div id="search-results" class="{% if not texto %}hidden{% endif %}">
				<div
					class="grid grid-cols-1 lg:grid-cols-2 gap-6">

					<!-- COLUMNA PILOTOS -->
					<div class="bg-slate-900 border border-slate-800 p-5 rounded-xl shadow-lg">
						<div class="flex justify-between items-center text-[10px] font-racing text-slate-500 uppercase tracking-wider mb-4">
							<span>Pilotos Coincidentes</span>
							<span id="count-pilotos" class="text-cyan-400 font-bold">REGISTROS:
								{{ pilotos|length }}</span>
						</div>
						{# Bloque de Pilotos #}
						<div id="list-pilotos" class="space-y-2">
							{% for piloto in pilotos %}
								{% set media = (piloto.statClasificacion + piloto.statRitmo + piloto.statConsistencia + piloto.statAdelantamiento + piloto.statDefensa + piloto.statGestionNeumaticos + piloto.statMojado) / 7 %}

								{# 🟢 ENLACE AÑADIDO AQUÍ #}
								<a href="{{ path('app_career_profile', { 'partidaId': partidaId, 'idPilotoIa': piloto.id }) }}" class="block transition-transform hover:scale-[1.01]">
									<div class="flex items-center justify-between p-3 rounded-lg border bg-slate-950/40 border-slate-900/60 text-slate-400 hover:border-cyan-500/50">
										<div>
											<span class="text-xs font-racing uppercase tracking-wide text-white block">{{ piloto.nombre }}
												{{ piloto.apellido }}</span>
											<span class="text-[9px] font-mono text-slate-500 block uppercase">Categoría:
												<span class="text-slate-400 font-bold">{{ piloto.categoria }}</span>
											</span>
										</div>
										<div class="text-right">
											<span class="text-[8px] font-mono text-slate-600 block uppercase">Media Gral</span>
											<span class="font-mono text-xs font-black {% if media >= 80 %}text-emerald-400{% elseif media >= 70 %}text-amber-400{% else %}text-red-400{% endif %}">{{ media|round }}
												OVR</span>
										</div>
									</div>
								</a>
							{% endfor %}
						</div>
					</div>

					<!-- COLUMNA ESCUDERÍAS -->
					<div class="bg-slate-900 border border-slate-800 p-5 rounded-xl shadow-lg">
						<div class="flex justify-between items-center text-[10px] font-racing text-slate-500 uppercase tracking-wider mb-4">
							<span>Escuderías Coincidentes</span>
							<span id="count-escuderias" class="text-cyan-400 font-bold">REGISTROS:
								{{ escuderias|length }}</span>
						</div>
						<div id="list-escuderias" class="space-y-2">
							{% for escuderia in escuderias %}
							<a href="{{ path('app_career_escuderia_profile', { 'partidaId': partidaId, 'escuderiaId': escuderia.id }) }}" class="block transition-transform hover:scale-[1.01]">
								<div>
									<div>
										<span class="text-xs font-racing uppercase tracking-wide text-white block">{{ escuderia.nombreOficial }}</span>
										<span class="text-[9px] font-mono text-slate-500 block uppercase">División FIA Competitiva</span>
									</div>
									<span class="text-[10px] font-mono bg-slate-900 px-2 py-0.5 rounded border border-slate-800 text-cyan-400 font-bold uppercase tracking-wider">{{ escuderia.categoria }}</span>
								</div>
							</a>
							{% endfor %}
						</div>
					</div>

				</div>
			</div>

			<!-- ESTADO VACÍO -->
			<div id="initial-state" class="text-center py-16 bg-slate-900/20 border border-dashed border-slate-900 rounded-xl backdrop-blur-sm {% if texto %}hidden{% endif %}">
				<span class="text-3xl block mb-2 opacity-50">📡</span>
				<h3 class="text-sm font-racing uppercase tracking-wider text-slate-400">Terminal FIA de Consulta en Espera</h3>
				<p class="text-xs text-slate-600 font-mono mt-1 max-w-md mx-auto">Escribe en el cuadro superior para filtrar la información actual de la partida.</p>
			</div>

		</div>
	</div>

	<!-- JS MOTOR AJAX -->
	<script>
		document.addEventListener('DOMContentLoaded', () => {
const searchInput = document.getElementById('search-input');
const searchResults = document.getElementById('search-results');
const initialState = document.getElementById('initial-state');

const listPilotos = document.getElementById('list-pilotos');
const listEscuderias = document.getElementById('list-escuderias');
const countPilotos = document.getElementById('count-pilotos');
const countEscuderias = document.getElementById('count-escuderias');

let timeout = null;

searchInput.addEventListener('input', (e) => {
clearTimeout(timeout);
const query = e.target.value.trim();

if (query.length < 2) {
if (searchResults) 
searchResults.classList.add('hidden');

if (initialState) 
initialState.classList.remove('hidden');

return;
}

timeout = setTimeout(() => {
fetch (`{{ path('app_career_search', { 'partidaId': partidaId }) }}?q=${
encodeURIComponent(query)
}`, {
headers: {
'X-Requested-With': 'XMLHttpRequest'
}
}).then(response => response.json()).then(data => {
initialState.classList.add('hidden');
searchResults.classList.remove('hidden');

document.getElementById('count-pilotos').textContent = `REGISTROS: ${
data.pilotos.length
}`;
countEscuderias.textContent = `REGISTROS: ${
data.escuderias.length
}`;

// Renderizado Pilotos
// Dentro del .then(data => { ... }) en la sección de Renderizar Pilotos
if (data.pilotos.length > 0) {
    listPilotos.innerHTML = data.pilotos.map(p => {
        const badgeColor = p.media >= 80 ? 'text-emerald-400' : (p.media >= 70 ? 'text-amber-400' : 'text-red-400');
        
        // 🟢 ENLACE DINÁMICO AÑADIDO AQUÍ
        return `
            <a href="/career/profile/${ {{ partidaId }} }/${p.id}" class="block transition-transform hover:scale-[1.01]">
                <div class="flex items-center justify-between p-3 rounded-lg border bg-slate-950/40 border-slate-900/60 text-slate-400 hover:border-cyan-500/50">
                    <div>
                        <span class="text-xs font-racing uppercase tracking-wide text-white block">${p.nombre} ${p.apellido}</span>
                        <span class="text-[9px] font-mono text-slate-500 block uppercase">Categoría: <span class="text-slate-400 font-bold">${p.categoria}</span></span>
                    </div>
                    <div class="text-right">
                        <span class="text-[8px] font-mono text-slate-600 block uppercase">Media Gral</span>
                        <span class="font-mono text-xs font-black ${badgeColor}">${p.media} OVR</span>
                    </div>
                </div>
            </a>
        `;
    }).join('');
} else {
listPilotos.innerHTML = `<p class="text-xs text-slate-500 italic font-mono py-4 text-center">No hay coincidencias.</p>`;
}

// Renderizado Escuderías
if (data.escuderias.length > 0) {
    listEscuderias.innerHTML = data.escuderias.map(e => `
        <a href="/career/escuderia/profile/${ {{ partidaId }} }/${e.id}" class="block transition-transform hover:scale-[1.01]">
            <div class="flex items-center justify-between p-3 rounded-lg border bg-slate-950/40 border-slate-900/60 text-slate-400 hover:border-amber-500/50">
                <div>
                    <span class="text-xs font-racing uppercase tracking-wide text-white block">${e.nombreOficial}</span>
                    <span class="text-[9px] font-mono text-slate-500 block uppercase">División FIA Competitiva</span>
                </div>
                <span class="text-[10px] font-mono bg-slate-900 px-2 py-0.5 rounded border border-slate-800 text-amber-400 font-bold uppercase tracking-wider">${e.categoria}</span>
            </div>
        </a>
    `).join('');
}else {
listEscuderias.innerHTML = `<p class="text-xs text-slate-500 italic font-mono py-4 text-center">No hay coincidencias.</p>`;
}
});
}, 250); // Velocidad de respuesta de 250ms
});
});
	</script>
{% endblock %}
