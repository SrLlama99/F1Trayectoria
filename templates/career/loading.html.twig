{% extends 'base.html.twig' %}

{% block title %}FIA - GENERANDO UNIVERSO MOTOR{% endblock %}

{% block body %}
<div class="relative min-h-screen flex flex-col items-center justify-center bg-slate-950 text-white overflow-hidden p-6">
    <div class="absolute inset-0 z-0 bg-[linear-gradient(rgba(18,24,38,0.2)_1px,transparent_1px),linear-gradient(90deg,rgba(18,24,38,0.2)_1px,transparent_1px)] bg-[size:40px_40px]"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-red-600/5 rounded-full blur-[120px] z-0"></div>

    <div class="relative z-10 w-full max-w-lg text-center">
        <!-- Spinner animado emulando escaneo de radar -->
        <div class="relative w-24 h-24 mx-auto mb-8">
            <div class="absolute inset-0 border-4 border-slate-900 rounded-full"></div>
            <div class="absolute inset-0 border-4 border-t-red-600 border-r-transparent border-b-transparent border-l-transparent rounded-full animate-spin"></div>
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 font-racing text-xs text-red-500 tracking-wider">FIA</div>
        </div>

        <h2 class="font-racing text-sm tracking-[0.4em] text-cyan-400 uppercase animate-pulse">Procesamiento Cuántico de Datos</h2>
        <h1 class="font-racing text-3xl font-black uppercase italic tracking-wide mt-1">Generando <span class="text-red-600">Ecosistema</span></h1>
        
        <!-- Caja de terminal con logs dinámicos -->
        <div class="mt-8 bg-slate-950 border border-slate-800 p-4 rounded text-left font-mono text-[11px] text-slate-400 space-y-1 h-36 overflow-hidden shadow-inner">
            <div id="log1" class="text-cyan-400">⚡ Inicializando algoritmos de asignación de escuderías...</div>
            <div id="log2" class="hidden">📦 Estructurando categorías FIA: Karting, F3, F2 y F1...</div>
            <div id="log3" class="hidden">✍️ Redactando contratos deportivos y cuadrando dorsales...</div>
            <div id="log4" class="hidden text-emerald-400">🏁 Trazando calendarios y sincronizando circuitos del mundial...</div>
        </div>
    </div>
</div>

<script>
    // Efectos cosméticos en el log
    setTimeout(() => document.getElementById('log2').classList.remove('hidden'), 1000);
    setTimeout(() => document.getElementById('log3').classList.remove('hidden'), 2200);
    setTimeout(() => document.getElementById('log4').classList.remove('hidden'), 3500);

    // Disparador del proceso real de generación en boxes
    document.addEventListener("DOMContentLoaded", function() {
        fetch("/api/career/generate-world/{{ partidaId }}", { method: 'POST' })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Redireccionamos a la pantalla de selección de ofertas de contrato pasando el ID de la partida
                    window.location.href = "/career/offers/" + {{ partidaId }};
                } else {
                    alert("CRASH EN CENTRAL: " + data.message);
                }
            })
            .catch(error => alert("PÉRDIDA DE TELEMETRÍA CON EL SERVIDOR"));
    });
</script>
{% endblock %}