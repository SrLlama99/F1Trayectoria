{% extends 'base.html.twig' %}

{% set partidaId = partida.idPartida %}

{% block title %}CASINO ROYAL - BLACKJACK 21{% endblock %}

{% block body %}
	<div class="min-h-screen bg-slate-950 text-white p-6 pl-20 transition-all">
		<div class="max-w-4xl mx-auto space-y-6">

			<header class="flex justify-between items-center bg-slate-900/40 border border-amber-500/25 p-4 rounded-xl backdrop-blur-sm">
				<div class="flex items-center gap-3">
					<span class="text-2xl p-2 bg-slate-950 rounded-lg border border-slate-800">🃏</span>
					<div>
						<span class="text-amber-500 font-racing text-[10px] tracking-widest block uppercase">Mesa de Alta Sociedad</span>
						<h1 class="text-xl font-black font-racing uppercase tracking-wide">Blackjack 21</h1>
					</div>
				</div>

				<div class="text-right font-mono text-xs">
					<span class="text-slate-500 block text-[9px] font-racing uppercase">Tu Cartera</span>
					<span class="text-emerald-400 font-bold text-sm tracking-wide" id="cartera-visual">
						€ {{ piloto.dinero|number_format(0, ',', '.') }}
					</span>
				</div>
			</header>

			<div class="bg-slate-900 border border-slate-800 rounded-xl p-6 shadow-2xl relative overflow-hidden">
				<div class="absolute top-0 right-0 w-80 h-80 bg-emerald-500/5 rounded-full blur-3xl pointer-events-none"></div>

				<div id="contenedor-apuesta" class="space-y-6 max-w-md mx-auto py-8 text-center">
					<h2 class="font-racing text-lg font-black uppercase text-amber-400 tracking-wide">Define tu Apuesta</h2>
					<p class="text-xs text-slate-400 font-mono">Ajusta los fondos para esta mano. Si ganas la partida, recuperarás tu apuesta y ganarás una cantidad equivalente (1:1).</p>
					
					<div class="bg-slate-950 border border-slate-800 p-6 rounded-2xl shadow-inner relative">
						<span class="text-[9px] font-racing text-slate-500 uppercase tracking-widest block mb-1">CANTIDAD EN JUEGO</span>
						<div class="text-3xl font-black font-mono text-white tracking-wide" id="texto-apuesta">€ 5.000</div>
						
						<div class="mt-3 text-[10px] font-mono text-emerald-400 bg-emerald-500/10 py-1 px-3 rounded-full border border-emerald-500/20 inline-block">
							💰 Beneficio potencial: <span id="texto-premio" class="font-bold">€ 5.000</span>
						</div>
					</div>

					<div class="grid grid-cols-4 gap-2 font-mono text-xs">
						<button onclick="modificarApuesta(-5000)" class="bg-slate-950 hover:bg-slate-800 border border-slate-800 py-2.5 rounded-lg active:scale-95 transition-all text-rose-400 font-bold">-5K</button>
						<button onclick="modificarApuesta(-1000)" class="bg-slate-950 hover:bg-slate-800 border border-slate-800 py-2.5 rounded-lg active:scale-95 transition-all text-rose-300">-1K</button>
						<button onclick="modificarApuesta(1000)" class="bg-slate-950 hover:bg-slate-800 border border-slate-800 py-2.5 rounded-lg active:scale-95 transition-all text-emerald-300">+1K</button>
						<button onclick="modificarApuesta(5000)" class="bg-slate-950 hover:bg-slate-800 border border-slate-800 py-2.5 rounded-lg active:scale-95 transition-all text-emerald-400 font-bold">+5K</button>
					</div>

					<div id="wrapper-btn-repartir">
						{% if piloto.jugadasCasino >= 3 %}
							<button disabled class="w-full font-racing text-xs font-black tracking-widest uppercase bg-slate-800 border border-slate-700 text-slate-500 py-4 rounded-xl cursor-not-allowed opacity-60">
								🚫 LÍMITE SEMANAL SUPERADO
							</button>
						{% else %}
							<button onclick="iniciarMano()" id="btn-repartir-accion" class="w-full font-racing text-xs font-black tracking-widest uppercase bg-gradient-to-r from-amber-500 to-yellow-400 hover:from-amber-400 hover:to-yellow-300 text-slate-950 py-4 rounded-xl transition-all shadow-[0_4px_20px_rgba(245,158,11,0.2)] active:scale-[0.99]">
								♣️ REPARTIR CARTAS ♥️
							</button>
						{% endif %}
					</div>
				</div>

				<div id="tapete" class="hidden space-y-8 py-4">
					<div class="space-y-2">
						<div class="flex justify-between items-center text-xs font-mono">
							<span class="text-slate-500 uppercase font-racing text-[10px]">Mesa del Crupier</span>
							<span class="bg-slate-950 px-2 py-0.5 rounded border border-slate-800 text-slate-400" id="puntos-banca">Puntos: ??</span>
						</div>
						<div id="cartas-banca" class="flex gap-2 p-4 bg-slate-950/40 border border-slate-900 rounded-xl min-h-[110px] items-center justify-center"></div>
					</div>

					<div class="relative flex py-2 items-center">
						<div class="flex-grow border-t border-slate-800/80"></div>
						<span class="flex-shrink mx-4 text-[9px] font-mono text-slate-600 tracking-widest uppercase">Tapete de Blackjack</span>
						<div class="flex-grow border-t border-slate-800/80"></div>
					</div>

					<div class="space-y-2">
						<div class="flex justify-between items-center text-xs font-mono">
							<span class="text-amber-400 uppercase font-racing text-[10px]">Tus Cartas (Apuesta: <span id="apuesta-activa">€0</span>)</span>
							<span class="bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/20 text-amber-400 font-bold" id="puntos-jugador">Puntos: 0</span>
						</div>
						<div id="cartas-jugador" class="flex gap-2 p-4 bg-slate-950/40 border border-slate-900 rounded-xl min-h-[110px] items-center justify-center"></div>
					</div>

					<div id="mensaje-resultado" class="hidden text-center font-racing text-lg uppercase tracking-wide py-3 rounded-xl border"></div>

					<div class="grid grid-cols-2 sm:grid-cols-3 gap-3 font-racing text-xs" id="controles-juego">
						<button onclick="pedirCarta()" id="btn-pedir" class="bg-slate-950 hover:bg-slate-800 text-white border border-slate-800 py-3 rounded-lg font-black tracking-wider uppercase transition-all active:scale-95">➕ PEDIR CARTA</button>
						<button onclick="plantarse()" id="btn-plantarse" class="bg-slate-950 hover:bg-slate-800 text-amber-400 border border-slate-800 py-3 rounded-lg font-black tracking-wider uppercase transition-all active:scale-95">✋ PLANTARSE</button>
						<button onclick="reiniciarInterfaz()" id="btn-otra-mano" class="hidden col-span-full sm:col-span-1 bg-gradient-to-r from-cyan-500 to-sky-500 text-slate-950 py-3 rounded-lg font-black tracking-wider uppercase transition-all shadow-md">OTRA MANO →</button>
					</div>
				</div>

			</div>

			<div class="text-center">
				<a href="/career/casino/{{ partida.idPartida }}" id="btn-salir" class="inline-block font-mono text-xs text-slate-500 hover:text-slate-300 transition-colors">
					← Salir de la mesa y volver al menú
				</a>
			</div>

		</div>
	</div>

	<div id="modal-casino-aviso" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 backdrop-blur-md bg-slate-950/80 transition-all duration-300">
		<div class="bg-slate-900 border-2 border-rose-500/40 rounded-2xl max-w-md w-full p-6 shadow-[0_0_30px_rgba(244,63,94,0.15)] text-center space-y-4 relative overflow-hidden">
			<div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-rose-500 via-orange-400 to-rose-500"></div>
			<div class="w-16 h-16 bg-rose-500/10 border border-rose-500/30 rounded-full flex items-center justify-center mx-auto text-2xl animate-pulse">🚫</div>
			<div class="space-y-1">
				<h3 id="modal-titulo" class="font-racing text-lg uppercase tracking-wide text-rose-400">Acceso Denegado</h3>
				<p id="modal-mensaje" class="font-mono text-xs text-slate-400 leading-relaxed"></p>
			</div>
			<div class="pt-2 flex gap-2">
				<button onclick="cerrarModalCasino()" id="btn-modal-accion" class="flex-1 font-mono text-xs font-bold uppercase bg-slate-950 hover:bg-slate-800 border border-slate-800 px-4 py-2.5 rounded-xl transition-all text-slate-300">Entendido</button>
				<a href="/career/casino/{{ partida.idPartida }}" id="btn-modal-salir" class="hidden flex-1 font-racing text-xs font-black tracking-widest uppercase bg-gradient-to-r from-rose-500 to-orange-500 hover:from-rose-400 hover:to-orange-400 text-slate-950 px-4 py-2.5 rounded-xl transition-all shadow-md text-center flex items-center justify-center">🚪 VOLVER AL MENÚ</a>
			</div>
		</div>
	</div>

	<script>
		let dineroDisponible = {{ piloto.dinero }};
		let apuestaActual = 5000;
		const minimaApuesta = 1;
		
		// 🌟 CONTADOR DE JUGADAS LOCALES DESDE SERVIDOR
		let jugadasEfectuadas = {{ piloto.jugadasCasino|default(0) }};
		let limiteAlcanzado = jugadasEfectuadas >= 3;
		
		let baraja = [];
		let manoJugador = [];
		let manoBanca = [];
		let juegoTerminado = true;

		window.addEventListener('DOMContentLoaded', () => {
			if (limiteAlcanzado) {
				ejecutarBloqueoAbsoluto();
			}
		});

		function mostrarModalCasino(titulo, mensaje, forzarSalida = false) {
			document.getElementById('modal-titulo').innerText = titulo;
			document.getElementById('modal-mensaje').innerText = mensaje;
			
			const btnAccion = document.getElementById('btn-modal-accion');
			const btnSalir = document.getElementById('btn-modal-salir');

			if (forzarSalida) {
				btnAccion.classList.add('hidden');
				btnSalir.classList.remove('hidden');
			} else {
				btnAccion.classList.remove('hidden');
				btnSalir.classList.add('hidden');
			}
			document.getElementById('modal-casino-aviso').classList.remove('hidden');
		}

		function cerrarModalCasino() {
			document.getElementById('modal-casino-aviso').classList.add('hidden');
		}

		function modificarApuesta(cantidad) {
			if (limiteAlcanzado) {
				ejecutarBloqueoAbsoluto();
				return;
			}
			apuestaActual += cantidad;
			if (apuestaActual < minimaApuesta) apuestaActual = minimaApuesta;
			if (apuestaActual > dineroDisponible) apuestaActual = dineroDisponible;

			document.getElementById('texto-apuesta').innerText = '€ ' + apuestaActual.toLocaleString('es-ES');
			document.getElementById('texto-premio').innerText = '€ ' + apuestaActual.toLocaleString('es-ES');
		}

		function crearBaraja() {
			const palos = ['♠', '♥', '♦', '♣'];
			const valores = [
				{n: 'A', v: 11}, {n: '2', v: 2}, {n: '3', v: 3}, {n: '4', v: 4}, 
				{n: '5', v: 5}, {n: '6', v: 6}, {n: '7', v: 7}, {n: '8', v: 8}, 
				{n: '9', v: 9}, {n: '10', v: 10}, {n: 'J', v: 10}, {n: 'Q', v: 10}, {n: 'K', v: 10}
			];
			baraja = [];
			for (let p of palos) {
				for (let v of valores) {
					baraja.push({ ...v, palo: p });
				}
			}
			baraja.sort(() => Math.random() - 0.5);
		}

		function calcularPuntos(mano) {
			let puntos = mano.reduce((total, carta) => total + carta.v, 0);
			let ases = mano.filter(carta => carta.n === 'A').length;
			while (puntos > 21 && ases > 0) {
				puntos -= 10;
				ases--;
			}
			return puntos;
		}

		function renderizarCartaHTML(carta, oculta = false) {
			if (oculta) {
				return `<div class="w-14 h-20 bg-gradient-to-br from-red-800 to-red-950 border-2 border-white rounded-lg flex items-center justify-center shadow-md shadow-black/50"><span class="text-white/30 text-lg font-bold">👑</span></div>`;
			}
			const esRojo = carta.palo === '♥' || carta.palo === '♦';
			return `<div class="w-14 h-20 bg-white border border-slate-300 text-slate-900 rounded-lg flex flex-col justify-between p-1.5 shadow-md font-mono font-bold">
						<div class="text-left text-xs leading-none ${esRojo ? 'text-red-600' : 'text-slate-900'}">${carta.n}</div>
						<div class="text-center text-xl leading-none ${esRojo ? 'text-red-600' : 'text-slate-900'}">${carta.palo}</div>
						<div class="text-right text-xs leading-none ${esRojo ? 'text-red-600' : 'text-slate-900'}">${carta.n}</div>
					</div>`;
		}

		function iniciarMano() {
			// 🛑 COMPROBACIÓN FULMINANTE ANTES DE REPARTIR (Evita el Límite + 1)
			if (jugadasEfectuadas >= 3 || limiteAlcanzado) {
				limiteAlcanzado = true;
				ejecutarBloqueoAbsoluto();
				return;
			}

			if (dineroDisponible < apuestaActual) {
				mostrarModalCasino("FONDOS INSUFICIENTES", `No dispones de capital para cubrir esta apuesta.`, false);
				return;
			}
			
			// Si pasa el filtro, sumamos la jugada de forma preventiva a nivel de interfaz
			jugadasEfectuadas++; 

			document.getElementById('contenedor-apuesta').classList.add('hidden');
			document.getElementById('tapete').classList.remove('hidden');
			document.getElementById('apuesta-activa').innerText = '€ ' + apuestaActual.toLocaleString('es-ES');
			
			juegoTerminado = false;
			document.getElementById('mensaje-resultado').className = "hidden text-center font-racing text-lg uppercase tracking-wide py-3 rounded-xl border";
			document.getElementById('btn-otra-mano').classList.add('hidden');

			crearBaraja();
			manoJugador = [baraja.pop(), baraja.pop()];
			manoBanca = [baraja.pop(), baraja.pop()];

			actualizarTablero(true);
		}

		function actualizarTablero(ocultarBanca = true) {
			document.getElementById('cartas-jugador').innerHTML = manoJugador.map(c => renderizarCartaHTML(c)).join('');
			document.getElementById('puntos-jugador').innerText = 'Puntos: ' + calcularPuntos(manoJugador);

			if (ocultarBanca) {
				document.getElementById('cartas-banca').innerHTML = renderizarCartaHTML(manoBanca[0]) + renderizarCartaHTML(null, true);
				document.getElementById('puntos-banca').innerText = 'Puntos: ??';
			} else {
				document.getElementById('cartas-banca').innerHTML = manoBanca.map(c => renderizarCartaHTML(c)).join('');
				document.getElementById('puntos-banca').innerText = 'Puntos: ' + calcularPuntos(manoBanca);
			}

			if (calcularPuntos(manoJugador) > 21) {
				finalizarMano('BANCA_GANA', 'Te has pasado de 21. La banca gana.');
			}
		}

		function pedirCarta() {
			if (juegoTerminado) return;
			manoJugador.push(baraja.pop());
			actualizarTablero(true);
		}

		function plantarse() {
			if (juegoTerminado) return;
			
			let puntosBanca = calcularPuntos(manoBanca);
			while (puntosBanca < 17) {
				manoBanca.push(baraja.pop());
				puntosBanca = calcularPuntos(manoBanca);
			}

			actualizarTablero(false);
			let puntosJugador = calcularPuntos(manoJugador);

			if (puntosBanca > 21) {
				finalizarMano('JUGADOR_GANA', '¡La banca se ha pasado! Tú ganas.');
			} else if (puntosJugador > puntosBanca) {
				finalizarMano('JUGADOR_GANA', '¡Felicidades! Superas a la banca.');
			} else if (puntosJugador < puntosBanca) {
				finalizarMano('BANCA_GANA', 'La banca gana la mano.');
			} else {
				finalizarMano('EMPATE', 'Empate técnico. Recuperas tus fondos.');
			}
		}

		function finalizarMano(resultado, mensaje) {
			juegoTerminado = true;
			const contenedorMsg = document.getElementById('mensaje-resultado');
			contenedorMsg.classList.remove('hidden');
			contenedorMsg.innerText = mensaje;
			
			// Solo mostramos el botón de "Otra mano" si no hemos llegado a las 3 jugadas reglamentarias
			if (jugadasEfectuadas < 3) {
				document.getElementById('btn-otra-mano').classList.remove('hidden');
			} else {
				limiteAlcanzado = true;
			}

			let dineroPrevio = dineroDisponible;

			if (resultado === 'JUGADOR_GANA') {
				contenedorMsg.classList.add('bg-emerald-500/10', 'border-emerald-500/30', 'text-emerald-400');
				dineroDisponible += apuestaActual;
			} else if (resultado === 'BANCA_GANA') {
				contenedorMsg.classList.add('bg-rose-500/10', 'border-rose-500/30', 'text-rose-400');
				dineroDisponible -= apuestaActual;
			} else {
				contenedorMsg.classList.add('bg-slate-800', 'border-slate-700', 'text-slate-300');
			}

			document.getElementById('cartera-visual').innerText = '€ ' + dineroDisponible.toLocaleString('es-ES');

			// Agregamos la variable {{ partidaId }} a la llamada URL
			fetch(`/career/casino/api/save-blackjack/{{ partidaId }}/${resultado}/${apuestaActual}`)
				.then(response => {
					if (response.status === 403 || jugadasEfectuadas >= 3) {
						limiteAlcanzado = true; 
						dineroDisponible = dineroPrevio;
						document.getElementById('cartera-visual').innerText = '€ ' + dineroDisponible.toLocaleString('es-ES');
						
						contenedorMsg.className = "text-center font-racing text-lg uppercase tracking-wide py-3 rounded-xl border block bg-rose-500/20 border-rose-500 text-rose-400";
						contenedorMsg.innerText = "🛑 LÍMITE DE JUGADAS ALCANZADO.";

						document.getElementById('btn-pedir').disabled = true;
						document.getElementById('btn-plantarse').disabled = true;
						document.getElementById('btn-otra-mano').classList.add('hidden');

						ejecutarBloqueoAbsoluto();
					}
				});
		}

		function reiniciarInterfaz() {
			if (jugadasEfectuadas >= 3 || limiteAlcanzado) {
				ejecutarBloqueoAbsoluto();
				return;
			}
			document.getElementById('tapete').classList.add('hidden');
			document.getElementById('contenedor-apuesta').classList.remove('hidden');
			modificarApuesta(0);
		}

		// 🌟 FUNCIÓN AUXILIAR DE CONTROL ABSOLUTO: Centraliza el corte definitivo de jugadas
		function ejecutarBloqueoAbsoluto() {
			limiteAlcanzado = true;
			document.getElementById('wrapper-btn-repartir').innerHTML = `
				<button disabled class="w-full font-racing text-xs font-black tracking-widest uppercase bg-slate-800 border border-slate-700 text-slate-500 py-4 rounded-xl cursor-not-allowed opacity-60">
					🚫 LÍMITE SEMANAL SUPERADO
				</button>
			`;
			mostrarModalCasino(
				"LÍMITE ALCANZADO", 
				"Has alcanzado tus 3 créditos reglamentarios semanales en el casino. Debes regresar al paddock para continuar con las actividades oficiales de la escudería.", 
				true
			);
		}
	</script>
{% endblock %}