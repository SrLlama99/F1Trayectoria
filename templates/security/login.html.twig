{% extends 'base.html.twig' %}

{% block title %}F1 TRAYECTORIA - LOGIN SYSTEM{% endblock %}

{% block body %}
<div class="relative min-h-screen flex items-center justify-center overflow-hidden p-4">

    <div class="absolute inset-0 z-0 bg-[linear-gradient(rgba(18,24,38,0.4)_1px,transparent_1px),linear-gradient(90deg,rgba(18,24,38,0.4)_1px,transparent_1px)] bg-[size:30px_30px]"></div>
    
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-red-600/10 rounded-full blur-[120px] z-0"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-cyan-500/10 rounded-full blur-[120px] z-0"></div>

    <div class="relative w-full max-w-md bg-slate-950/80 border-t-4 border-red-600 border-x border-b border-slate-800 p-8 rounded-b-xl shadow-[0_0_50px_rgba(0,0,0,0.8)] backdrop-blur-md z-10">
        
        <div class="absolute top-2 right-4 flex space-x-1">
            <span class="w-2 h-2 bg-red-600 animate-pulse"></span>
            <span class="w-2 h-2 bg-slate-700"></span>
            <span class="w-2 h-2 bg-slate-700"></span>
        </div>
        <div class="absolute top-2 left-4 text-xs text-slate-500 font-racing tracking-widest">SYS.STATUS: ONLINE</div>

        <div class="text-center mb-8">
            <h1 class="font-racing text-3xl font-black text-white tracking-wider italic">
                F1<span class="text-red-600 text-2xl">//</span>TRAYECTORIA
            </h1>
            <p id="panel-subtitle" class="text-xs text-cyan-400 font-racing tracking-widest uppercase mt-2">Acceso de Piloto</p>
        </div>

        <div id="system-alert" class="hidden mb-4 p-3 bg-red-950/50 border border-red-500 text-red-400 text-sm font-racing uppercase tracking-wider text-center rounded">
            ERROR: CREDENCIALES INVÁLIDAS
        </div>

        <form id="login-form" class="space-y-5 block">
            <div>
                <label class="block text-xs font-racing uppercase tracking-widest text-slate-400 mb-1">Nombre de Usuario</label>
                <input type="text" name="username" required autocomplete="off"
                    class="w-full bg-slate-900 border border-slate-700 focus:border-cyan-400 px-4 py-2 text-white placeholder-slate-600 focus:outline-none transition-colors rounded-sm font-racing tracking-wide shadow-inner"
                    placeholder="Escribe tu username...">
            </div>
            <div>
                <label class="block text-xs font-racing uppercase tracking-widest text-slate-400 mb-1">Código de Acceso (Password)</label>
                <input type="password" name="password" required
                    class="w-full bg-slate-900 border border-slate-700 focus:border-cyan-400 px-4 py-2 text-white placeholder-slate-600 focus:outline-none transition-colors rounded-sm font-racing tracking-wide shadow-inner"
                    placeholder="••••••••">
            </div>
            <button type="submit" 
                class="w-full relative group bg-red-600 hover:bg-red-700 text-white font-racing uppercase font-bold py-3 px-4 tracking-wider transition-all rounded-sm overflow-hidden shadow-[0_4px_15px_rgba(220,38,38,0.3)]">
                <span class="relative z-10">INICIAR IGNICIÓN</span>
                <div class="absolute inset-0 w-0 bg-white/10 transition-all group-hover:w-full z-0"></div>
            </button>
            <div class="text-center mt-4">
                <p class="text-slate-500 text-sm">¿Nuevo en la academia de pilotos? <button type="button" onclick="switchForm('register')" class="text-cyan-400 hover:underline font-racing text-xs tracking-wider">CREAR PERFIL</button></p>
            </div>
        </form>

        <form id="register-form" class="space-y-5 hidden">
            <div>
                <label class="block text-xs font-racing uppercase tracking-widest text-slate-400 mb-1">Alias del Piloto (Username)</label>
                <input type="text" name="reg-username" required autocomplete="off"
                    class="w-full bg-slate-900 border border-slate-700 focus:border-red-500 px-4 py-2 text-white placeholder-slate-600 focus:outline-none transition-colors rounded-sm font-racing tracking-wide shadow-inner"
                    placeholder="Ej: MagicAlonso...">
            </div>
            <div>
                <label class="block text-xs font-racing uppercase tracking-widest text-slate-400 mb-1">Enlace de Comunicación (Email)</label>
                <input type="email" name="reg-email" required autocomplete="off"
                    class="w-full bg-slate-900 border border-slate-700 focus:border-red-500 px-4 py-2 text-white placeholder-slate-600 focus:outline-none transition-colors rounded-sm font-racing tracking-wide shadow-inner"
                    placeholder="tu@correo.com">
            </div>
            <div>
                <label class="block text-xs font-racing uppercase tracking-widest text-slate-400 mb-1">Nueva Clave</label>
                <input type="password" name="reg-password" required
                    class="w-full bg-slate-900 border border-slate-700 focus:border-red-500 px-4 py-2 text-white placeholder-slate-600 focus:outline-none transition-colors rounded-sm font-racing tracking-wide shadow-inner"
                    placeholder="••••••••">
            </div>
            <button type="submit" 
                class="w-full relative group bg-cyan-500 hover:bg-cyan-600 text-slate-950 font-racing uppercase font-black py-3 px-4 tracking-wider transition-all rounded-sm overflow-hidden shadow-[0_4px_15px_rgba(6,182,212,0.3)]">
                <span class="relative z-10">REGISTRAR EN LA PARRILLA</span>
                <div class="absolute inset-0 w-0 bg-white/20 transition-all group-hover:w-full z-0"></div>
            </button>
            <div class="text-center mt-4">
                <p class="text-slate-500 text-sm">¿Ya tienes licencia de la FIA? <button type="button" onclick="switchForm('login')" class="text-red-500 hover:underline font-racing text-xs tracking-wider">ENTRAR</button></p>
            </div>
        </form>

    </div>
</div>

<script>
    const loginForm = document.getElementById('login-form');
    const registerForm = document.getElementById('register-form');
    const subtitle = document.getElementById('panel-subtitle');
    const alertBox = document.getElementById('system-alert');

    function switchForm(mode) {
        alertBox.classList.add('hidden');
        if (mode === 'register') {
            loginForm.classList.replace('block', 'hidden');
            registerForm.classList.replace('hidden', 'block');
            subtitle.textContent = "Registro de Nueva Licencia";
            subtitle.classList.replace('text-cyan-400', 'text-red-500');
        } else {
            registerForm.classList.replace('block', 'hidden');
            loginForm.classList.replace('hidden', 'block');
            subtitle.textContent = "Acceso de Piloto";
            subtitle.classList.replace('text-red-500', 'text-cyan-400');
        }
    }

    function showAlert(message, isSuccess = false) {
        alertBox.textContent = message;
        alertBox.classList.remove('hidden', 'bg-red-950/50', 'border-red-500', 'text-red-400', 'bg-emerald-950/50', 'border-emerald-500', 'text-emerald-400');
        
        if (isSuccess) {
            alertBox.classList.add('bg-emerald-950/50', 'border-emerald-500', 'text-emerald-400');
        } else {
            alertBox.classList.add('bg-red-950/50', 'border-red-500', 'text-red-400');
        }
    }

    // AJAX para Login
    // AJAX para Login Nativo Symfony (json_login)
    loginForm.addEventListener('submit', function(e) {
        e.preventDefault();
        
        // Obtenemos los valores directamente por ID o QuerySelector
        const username = loginForm.querySelector('input[name="username"]').value;
        const password = loginForm.querySelector('input[name="password"]').value;

        const payload = { username, password };

        fetch("{{ path('api_login') }}", {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(response => {
            if (!response.ok) {
                return response.json().then(err => { throw err; }).catch(() => { throw { message: 'ERROR DE CONEXIÓN' }; });
            }

            const ct = response.headers.get('content-type') || '';
            if (ct.includes('application/json')) {
                return response.json();
            }

            // Si la respuesta es 200 pero no trae JSON, asumimos éxito y redirigimos.
            return { success: true };
        })
        .then(data => {
            if (data && data.success) {
                window.location.href = "/dashboard";
            } else {
                showAlert("ERROR: " + (data.message || 'CREDENCIALES INCORRECTAS'));
            }
        })
        .catch(error => showAlert("ERROR: " + (error.message || 'ERROR DE CONEXIÓN')));
    });

    // AJAX para Registro
    registerForm.addEventListener('submit', function(e) {
        e.preventDefault();
        const formData = new FormData(registerForm);

        fetch("{{ path('api_register') }}", {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                showAlert("REGISTRO EXITOSO. LICENCIA EMITIDA.", true);
                setTimeout(() => {
                    switchForm('login');
                }, 2000);
            } else {
                showAlert("ERROR: " + data.message);
            }
        })
        .catch(error => showAlert("ERROR AL ENVIAR DATOS DEL PILOTO"));
    });
</script>
{% endblock %}